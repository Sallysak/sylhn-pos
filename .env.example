# ============================================================================
# SYLHN POS — Production Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values.
# For Vercel, set these in: Project → Settings → Environment Variables
# ============================================================================

# ===== CRITICAL (required for the app to run) =====

# Database connection (PostgreSQL — Neon / Supabase / Vercel Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Session/JWT signing secret — generate with: openssl rand -hex 32
# MUST be at least 32 characters. Used for signing session tokens + encrypting 2FA secrets.
SESSION_SECRET=REPLACE_WITH_32_CHAR_HEX_SECRET

# ===== HIGH PRIORITY (required for permanent production use) =====

# Cron job secret for automated backups — generate with: openssl rand -hex 16
# Used by POST /api/admin/backup/cron and POST /api/z-report/cron
CRON_SECRET=REPLACE_WITH_RANDOM_SECRET

# SMTP for email notifications (daily summary, low-stock alerts, PO emails)
# For Gmail: use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="SYLHN POS <noreply@sylhn.com>"

# ===== PAYMENT GATEWAYS (enables real mobile money + card payments) =====

# MTN MoMo (https://momodeveloper.mtn.com/)
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_ENVIRONMENT=sandbox

# Telecel Cash (formerly Vodafone Cash)
TELECEL_API_USER=
TELECEL_API_KEY=
TELECEL_SUBSCRIPTION_KEY=
TELECEL_ENVIRONMENT=sandbox

# AirtelTigo Money
AIRTELTIGO_API_USER=
AIRTELTIGO_API_KEY=
AIRTELTIGO_SUBSCRIPTION_KEY=
AIRTELTIGO_ENVIRONMENT=sandbox

# Paystack card payments (https://paystack.com/)
# Use sk_test_ for testing, sk_live_ for production
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ===== AI FEATURES (optional — for AI Assistant + Demand Forecast) =====
ZAI_API_KEY=Z.ai
ZAI_BASE_URL=https://internal-api.z.ai/v1
ZAI_TOKEN=your-zai-jwt-token-here
ZAI_CHAT_ID=
ZAI_USER_ID=

# ===== OPTIONAL =====

# PO approval threshold (POs above this amount require manager approval)
PO_APPROVAL_THRESHOLD=5000
NEXT_PUBLIC_PO_APPROVAL_THRESHOLD=5000

# FX API for auto exchange rates (free, no auth — defaults to open.er-api.com)
# FX_API_URL=https://open.er-api.com/v6/latest/GHS
